include LICENSE README.md CONTRIBUTING.md pyproject.toml .gitignore
include LOCAL_DEVELOPMENT.md AGENTS.md
recursive-include static *
recursive-include extensions *.ts
recursive-include tests *.py *.mjs
recursive-include docs *.md
recursive-include .github *.yml
include bin/airelay
include scripts/verify_chat_safety.py
include scripts/verify_executor.py
prune .relay
prune .local-dev
prune .cursor
prune .venv
prune build
prune dist
global-exclude __pycache__ *.py[cod] *.sqlite3 *.sqlite3-* *.token
